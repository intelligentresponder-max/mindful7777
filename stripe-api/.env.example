# Copy this to .env for local testing with `vercel dev` (never commit .env).
# In production, set these in the Vercel project dashboard instead.

# Secret key from https://dashboard.stripe.com/apikeys — starts with sk_live_ or sk_test_
STRIPE_SECRET_KEY=

# From `stripe listen` (local) or the webhook endpoint's signing secret (production)
STRIPE_WEBHOOK_SECRET=

# Price IDs from https://dashboard.stripe.com/products (not Payment Link/Buy
# Button IDs — the underlying recurring/one-time Price object)
STRIPE_PRICE_MEMBERSHIP=
STRIPE_PRICE_SUPPORT=
STRIPE_PRICE_SESSION_STANDARD=
STRIPE_PRICE_SESSION_VIP=
STRIPE_PRICE_SESSION_PREMIUM=

# Where Checkout should send people back to (membership + support).
# pages/membership.html was archived — vip.html is the current VIP page.
SUCCESS_URL_BASE=https://intelligentresponder-max.github.io/mindful7777/vip.html
CANCEL_URL_BASE=https://intelligentresponder-max.github.io/mindful7777/vip.html

# Where Checkout should send people back to for the 1:1 session products.
# pages/sessions.html was archived along with its Calendly link and the
# 77/100/150€ tiers. vip.html now advertises a differently-scoped "1:1
# Custom Session ab 97€" instead — review pricing/booking flow before
# enabling session_standard/session_vip/session_premium in production.
SESSIONS_URL_BASE_SUCCESS=https://intelligentresponder-max.github.io/mindful7777/vip.html
SESSIONS_URL_BASE_CANCEL=https://intelligentresponder-max.github.io/mindful7777/vip.html

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=https://intelligentresponder-max.github.io,https://mindful7777.de
