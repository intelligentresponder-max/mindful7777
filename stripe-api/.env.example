# Copy this to .env for local testing with `vercel dev` (never commit .env).
# In production, set these in the Vercel project dashboard instead.

# Secret key from https://dashboard.stripe.com/apikeys — starts with sk_live_ or sk_test_
STRIPE_SECRET_KEY=

# From `stripe listen` (local) or the webhook endpoint's signing secret (production)
STRIPE_WEBHOOK_SECRET=

# Price IDs from https://dashboard.stripe.com/products (not Payment Link/Buy
# Button IDs — the underlying recurring/one-time Price object)
STRIPE_PRICE_MEMBERSHIP=
STRIPE_PRICE_SUPPORT=

# Where Checkout should send people back to
SUCCESS_URL_BASE=https://intelligentresponder-max.github.io/mindful7777/pages/membership.html
CANCEL_URL_BASE=https://intelligentresponder-max.github.io/mindful7777/pages/membership.html

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=https://intelligentresponder-max.github.io,https://mindful7777.de
